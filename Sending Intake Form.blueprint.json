            "parameters": {
                "account": 14373100,
                "saveAfterSent": false
            },
            "mapper": {
                "cc": [],
                "to": [
                    "{{3.client_email}}"
                ],
                "bcc": [],
                "from": "",
                "text": "Dear {{3.client_name}}\n\nThank you for contacting Nautilus Law. We're excited to work with you.\r\n\r\nTo proceed, we need you to complete our intake form. This form helps us gather the necessary information to provide you with the best legal advice.\r\n\r\nPlease click the link below to access your form:\r\n\r\n{{3.form_link}}\n\r\nIf you have any questions or encounter any issues accessing the form, please don't hesitate to contact us.\r\n\nBest regards,\r\nNautilus Law",
                "sender": "",
                "headers": [],
                "replyTo": "",
                "subject": "Please Complete Your Intake Form",
                "priority": "normal",
                "inReplyTo": "",
                "references": [],
                "attachments": [],
                "contentType": "text"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "cc": {
                            "mode": "chose"
                        },
                        "to": {
                            "mode": "chose",
                            "items": [
                                null
                            ]
                        },
                        "bcc": {
                            "mode": "chose"
                        },
                        "priority": {
                            "label": "Normal"
                        },
                        "references": {
                            "mode": "chose"
                        },
                        "attachments": {
                            "mode": "chose"
                        },
                        "contentType": {
