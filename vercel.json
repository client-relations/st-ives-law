{
  "buildCommand": "cd artifacts/questionnaire && npm run build",
  "outputDirectory": "artifacts/questionnaire/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/templates/**"
    }
  },
  "rewrites": [
    {
      "source": "/lead-inquiry",
      "destination": "/lead-inquiry.html"
    },
    {
      "source": "/intake-form",
      "destination": "/intake-form.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 23 * * *"
    }
  ]
}
