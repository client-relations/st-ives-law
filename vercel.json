{
  "buildCommand": "cd artifacts/questionnaire && npm run build",
  "outputDirectory": "artifacts/questionnaire/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/lead-inquiry",
      "destination": "/lead-inquiry.html"
    },
    {
      "source": "/intake-form",
      "destination": "/intake-form.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
