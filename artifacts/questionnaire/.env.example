# Copy to .env.local and fill in real values. Never commit the filled file.
#
# NOTE: every VITE_* variable is embedded in the public browser bundle at build
# time. They are configuration, not secrets — anyone can read them from the
# deployed site. Never put a genuine secret behind a VITE_ prefix.

# Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Make.com webhooks
VITE_WEBHOOK_URL=https://hook.eu2.make.com/<hook-id>
VITE_CLIO_MATTER_WEBHOOK=https://hook.eu2.make.com/<hook-id>
VITE_SEND_FORM_EMAIL_WEBHOOK=https://hook.eu2.make.com/<hook-id>
VITE_SEND_INQUIRY_FORM_WEBHOOK=https://hook.eu2.make.com/<hook-id>
VITE_SEND_INTAKE_FORM_WEBHOOK=https://hook.eu2.make.com/<hook-id>
VITE_SEND_BACK_WEBHOOK=https://hook.eu2.make.com/<hook-id>
VITE_REMINDER_WEBHOOK=https://hook.eu2.make.com/<hook-id>
VITE_EMAIL_CONFIRMATION_WEBHOOK=https://hook.eu2.make.com/<hook-id>
