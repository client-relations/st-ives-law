# Copy to .env.local and fill in real values. Never commit the filled file.
#
# NOTE: every VITE_* variable is embedded in the public browser bundle at build
# time. They are configuration, not secrets — anyone can read them from the
# deployed site. Never put a genuine secret behind a VITE_ prefix.

# ── Browser (VITE_*) ─────────────────────────────────────────────────────────

# Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Public origin that clients can open (production domain, not a preview URL).
# Used for links the lawyer copies from the dashboard to send to a client.
VITE_PUBLIC_APP_URL=https://st-ives-law.vercel.app

# ── Server only (set in Vercel → Settings → Environment Variables) ────────────
# These are read by the functions in /api and never reach the browser. The
# Make webhook URLs used to be VITE_* variables; they now live here only.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
PUBLIC_APP_URL=https://st-ives-law.vercel.app

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/send-reminders.
CRON_SECRET=<long-random-string>

# Make.com webhooks
SEND_INQUIRY_FORM_WEBHOOK=https://hook.eu2.make.com/<hook-id>
SEND_INTAKE_FORM_WEBHOOK=https://hook.eu2.make.com/<hook-id>
SEND_BACK_WEBHOOK=https://hook.eu2.make.com/<hook-id>
REMINDER_WEBHOOK=https://hook.eu2.make.com/<hook-id>
CLIO_MATTER_WEBHOOK=https://hook.eu2.make.com/<hook-id>

# Clio document upload (api/send-to-clio-multipart.ts)
CLIO_CLIENT_ID=<client-id>
CLIO_CLIENT_SECRET=<client-secret>
CLIO_REFRESH_TOKEN=<refresh-token>
